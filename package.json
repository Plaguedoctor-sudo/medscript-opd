{
  "name": "medscript-opd",
  "version": "1.1.1",
  "description": "Offline-First Outpatient Prescription & Electronic Medical Records (EMR) System",
  "private": true,
  "license": "UNLICENSED",
  "author": "Dr. Nitin Hiralal Sonare <sonarenitin3@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Plaguedoctor-sudo/medscript-opd.git"
  },
  "bugs": {
    "url": "https://github.com/Plaguedoctor-sudo/medscript-opd/issues"
  },
  "homepage": "https://github.com/Plaguedoctor-sudo/medscript-opd#readme",
  "keywords": [
    "medical",
    "prescription",
    "opd",
    "emr",
    "ehr",
    "healthcare",
    "clinic",
    "offline-first",
    "nextjs",
    "sqlite",
    "flatpak"
  ],
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "dev:http": "next dev",
    "build": "next build",
    "start": "node server.js",
    "start:http": "next start",
    "ssl:generate": "bash scripts/generate-ssl.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "node scripts/seed.js",
    "db:backup": "node scripts/backup.js",
    "package:release": "bash scripts/package-release.sh",
    "package:secured": "bash scripts/package-secured-appliance.sh",
    "package:flatpak": "bash scripts/build-flatpak.sh",
    "code:lock": "sudo bash scripts/lock-local-development.sh",
    "code:unlock": "sudo bash scripts/unlock-local-development.sh",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --output-file bom.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  }
}
