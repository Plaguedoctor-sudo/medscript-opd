# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.crt
/certificates/
public/*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.aider*

# database
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite*
/backups/

# packaging & distribution
/dist/
/release/
/.release-stage/
/.flatpak-builder/
/build-dir/
start-hidden.vbs

# android build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties


